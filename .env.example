# Copiar este archivo a .env y completar los valores reales. NUNCA subir el .env a Git.

# --- Servidor / SSL ---
SERVER_PORT=8443
SSL_ENABLED=true
SSL_KEYSTORE_PASSWORD=<contraseña-del-keystore-restaurante.p12>

# --- PostgreSQL (perfil local) ---
DB_USERNAME=postgres
DB_PASSWORD=<password-de-postgres>

# --- PostgreSQL / Mongo (perfil docker) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=restaurante
DB_USER=postgres
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=restaurante

# --- MongoDB Atlas (perfil local) ---
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<db>

# --- JWT (Base64, minimo 32 bytes). Generar con: openssl rand -base64 48 ---
JWT_SECRET=<secreto-base64-de-al-menos-44-caracteres>
